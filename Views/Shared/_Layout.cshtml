<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] | Application Security Lab</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <nav class="navbar navbar-expand navbar-dark bg-dark">
        <div class="container flex-wrap gap-2">
            <a class="navbar-brand" href="/">Security Lab</a>
            <div class="d-flex gap-3 flex-wrap">
                <a class="nav-link text-white" href="/">XSS</a>
                <a class="nav-link text-white" href="/labs/">Exercises</a>
                <a class="nav-link text-white" href="/labs/authorization">IDOR / BOLA</a>
                <a class="nav-link text-white" href="/labs/sql-injection">SQL Injection</a>
                <a class="nav-link text-white" href="/labs/ssrf">SSRF</a>
            </div>
        </div>
    </nav>

    <main class="container py-4">
        @RenderBody()
    </main>

    @RenderSection("Scripts", required: false)
</body>
</html>
